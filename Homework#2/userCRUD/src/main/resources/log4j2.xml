<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="debug" strict="true"
               name="XMLConfigTest" packages="org.apache.logging.log4j.test">
    <Filter type="ThresholdFilter" level="trace" />

    <Appenders>
        <Console name="STDOUT">
            <Layout type="PatternLayout" pattern="%m %n" />
        </Console>
        <RollingFile name="rollingFile"
                     filePattern="logs/app-%d{yyyy-MM-dd  HH}-%i.log">
            <PatternLayout>
                <Pattern>%d %p %c{1.} [%t] %m%n</Pattern>
            </PatternLayout>
            <Policies>
                <TimeBasedTriggeringPolicy interval = "1" />
                <SizeBasedTriggeringPolicy
                    size="250 MB" />
            </Policies>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="DEBUG">
            <AppenderRef ref="STDOUT" />
            <AppenderRef ref="rollingFile" />
        </Root>
        <Logger name="org.hibernate.SQL" additivity="false" level="debug">
            <AppenderRef ref="rollingFile" />
        </Logger>
        <Logger name="org.hibernate.type.descriptor.sql.BasicBinder" additivity="false" level="trace">
            <AppenderRef ref="rollingFile" />
        </Logger>
        <Logger name="org.hibernate.type.descriptor.sql.BasicExtractor" additivity="false" level="debug">
            <AppenderRef ref="rollingFile" />
        </Logger>
        <Logger name="org.hibernate.engine.QueryParameters" additivity="false" level="debug">
            <AppenderRef ref="rollingFile" />
        </Logger>
        <Logger name="org.hibernate.engine.query.HQLQueryPlan" additivity="false" level="debug">
            <AppenderRef ref="rollingFile" />
        </Logger>
    </Loggers>

</Configuration>